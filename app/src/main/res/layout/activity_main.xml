<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Top Preview Box -->
    <androidx.cardview.widget.CardView
        android:id="@+id/previewCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#F8F9FA"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="100dp"
            android:padding="20dp"
            android:text="Customize this text and background using DialogHub!"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/previewCard"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Theme Mode Switcher Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Test Host App Theme Context:"
                        android:textColor="#1F2937"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgThemeMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbMaterial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Material Theme Context (Inherits Brand Colors)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbAppCompat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Legacy AppCompat Context (Auto-wrapped Fallback)"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/tvThemeStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Using: Material3 Theme (Direct inheritance)"
                        android:textColor="#4CAF50"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Invocation Mode Selector Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="API Invocation Paradigm:"
                        android:textColor="#1F2937"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgInvocationMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbModeDsl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Kotlin DSL &amp; Fluent Builder"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbModeCoroutine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Coroutines Async Suspension (await*)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbModeTraditional"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Traditional Callback / Listener"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Unified Text Studio Button -->
            <Button
                android:id="@+id/btnTextStudio"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#4F46E5"
                android:text="⭐ ALL-IN-ONE TEXT STUDIO"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Or Launch Individual Dialogs:"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Individual Dialog Buttons -->
            <Button
                android:id="@+id/btnImageSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="1. Image &amp; Gallery Selector"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnFontSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="2. Font Selector (Urdu / Custom Preview)"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnColorSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="3. Color Picker with Transparency"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnFormatSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="4. Text Format Dialog (Size &amp; Alignment)"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnEffectsSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="5. Text Effects Dialog (Shadow, Spacing, Styles)"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnStrokeSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="6. Text Stroke &amp; Outline Dialog"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnHighlightSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:text="7. Text Background Ribbon Dialog"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>