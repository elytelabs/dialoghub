<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Top Preview Box (Dedicated Canvas displaying active Image / Color) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/previewCard"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#0F172A"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Active Background Image in Preview Box -->
            <ImageView
                android:id="@+id/ivMainPreviewBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <!-- Subtle dark legibility scrim -->
            <View
                android:id="@+id/viewMainPreviewScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#20000000" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_margin="12dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="Customize this text and background using DialogHub!"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/previewCard"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Monetization & Daily Quota Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/quotaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvQuotaStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Daily Free Quota: 3/3 edits left"
                            android:textColor="#F3F4F6"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#3B82F6"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="FREE TIER"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSimulateRewardedAd"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:backgroundTint="#F59E0B"
                            android:text="📺 Watch Ad (12h Pass)"
                            android:textAllCaps="false"
                            android:textColor="#1F2937"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnTogglePro"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="#10B981"
                            android:text="👑 Toggle VIP / PRO"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Unified Text Studio Button -->
            <Button
                android:id="@+id/btnTextStudio"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#4F46E5"
                android:text="ALL-IN-ONE TEXT STUDIO"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Or Launch Individual Dialogs:"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Individual Dialog Buttons -->
            <Button
                android:id="@+id/btnImageSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="1. Image &amp; Gallery Selector"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnFontSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="2. Font Selector (Urdu / Custom Preview)"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnColorSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="3. Color Picker with Transparency"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnFormatSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="4. Text Format Dialog (Size &amp; Alignment)"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnEffectsSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="5. Text Effects Dialog (Shadow, Spacing, Styles)"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnStrokeSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="6. Text Stroke &amp; Outline Dialog"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnHighlightSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:text="7. Text Background Ribbon Dialog"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>