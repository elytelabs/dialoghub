<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/rounded_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <!-- Top Material Drag Handle Pill -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header with Title and Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/format_text"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?actionBarItemBackground"
            android:contentDescription="Close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Live Preview Box -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#F8F9FA"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <TextView
            android:id="@+id/tvLivePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:text="Preview Text / نمونہ"
            android:textColor="#212121"
            android:textDirection="anyRtl"
            android:textSize="20sp" />
    </androidx.cardview.widget.CardView>

    <!-- Text Size Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/text_size"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSizeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_background"
            android:backgroundTint="#EEEEEE"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="20sp"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekBarTextSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="30"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:progress="8"
        android:progressTint="?attr/colorPrimary"
        android:thumbTint="?attr/colorPrimary" />

    <!-- Text Alignment Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/text_alignment"
        android:textColor="#374151"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Segmented Alignment Buttons using MaterialButtonToggleGroup -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroupAlignment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:checkedButton="@id/btnAlignCenter"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlignLeft"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/align_left"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:icon="@drawable/ic_align_left"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlignCenter"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/align_center"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:icon="@drawable/ic_align_center"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlignRight"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/align_right"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:icon="@drawable/ic_align_right"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="18dp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>
