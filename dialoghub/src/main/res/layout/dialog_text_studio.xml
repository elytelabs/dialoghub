<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/rounded_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    tools:ignore="TooManyViews">

    <!-- Drag Handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header with 1-Tap Reset and Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvStudioTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/dh_text_studio"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStudioReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?actionBarItemBackground"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/dh_reset"
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?actionBarItemBackground"
            android:contentDescription="@string/dh_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Sleek In-Sheet Live Preview Canvas -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStudioPreview"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:visibility="visible"
        app:cardBackgroundColor="#0F172A"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardMaxElevation="4dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Real Wallpaper / Image Background in Preview Canvas -->
            <ImageView
                android:id="@+id/ivStudioPreviewBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Subtle border canvas overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_preview_canvas" />

            <TextView
                android:id="@+id/tvStudioPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/dh_sample_quote"
                android:textColor="#FFFFFF"
                android:textDirection="anyRtl"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Canvas Contrast Mode Toggle -->
            <ImageView
                android:id="@+id/btnStudioCanvasToggle"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#33FFFFFF"
                android:contentDescription="@string/dh_toggle_canvas_contrast"
                android:padding="5dp"
                android:src="@drawable/ic_contrast_toggle"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Studio Tab Strip -->
    <HorizontalScrollView
        android:id="@+id/hsvStudioTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerStudioTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 1. Font Tab -->
            <FrameLayout
                android:id="@+id/containerTabFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tabFont"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_selected"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="16dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="7dp"
                    android:text="@string/dh_tab_font"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/dotFontBadge"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tab_badge_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 2. Color Tab -->
            <FrameLayout
                android:id="@+id/containerTabColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/tabColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_unselected"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="16dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="7dp"
                    android:text="@string/dh_tab_color"
                    android:textColor="#4B5563"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/dotColorBadge"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tab_badge_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 3. Format Tab -->
            <FrameLayout
                android:id="@+id/containerTabFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/tabFormat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_unselected"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="16dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="7dp"
                    android:text="@string/dh_tab_format"
                    android:textColor="#4B5563"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/dotFormatBadge"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tab_badge_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 4. Effects Tab -->
            <FrameLayout
                android:id="@+id/containerTabEffects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/tabEffects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_unselected"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="16dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="7dp"
                    android:text="@string/dh_tab_effects"
                    android:textColor="#4B5563"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/dotEffectsBadge"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tab_badge_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Content Containers (300dp standard height for smooth nested scrolling) -->
    <FrameLayout
        android:id="@+id/containerStudioContent"
        android:layout_width="match_parent"
        android:layout_height="300dp">

        <!-- 1. Font View (Default) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStudioFonts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="4dp"
            android:visibility="visible" />

        <!-- 2. Color View -->
        <LinearLayout
            android:id="@+id/viewStudioColor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Category Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/containerStudioColorChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStudioColors"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- 3. Format View (Size & Alignment) - Scrollable -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/viewStudioFormat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="always"
            android:scrollbars="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/dh_text_size"
                        android:textColor="#374151"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStudioTextSizeVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="44dp"
                        android:gravity="center"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#EEEEEE"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="20sp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbStudioTextSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:max="32"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:progress="8"
                    android:progressTint="?attr/colorPrimary"
                    android:splitTrack="false"
                    android:thumbTint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dh_alignment"
                    android:textColor="#374151"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tgStudioAlignment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:checkedButton="@+id/btnStudioAlignCenter"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStudioAlignLeft"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        app:icon="@drawable/ic_align_left"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStudioAlignCenter"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        app:icon="@drawable/ic_align_center"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStudioAlignRight"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        app:icon="@drawable/ic_align_right"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Text Style Toggles (B, I, U, AA) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dh_text_style"
                    android:textColor="#374151"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStudioBold"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="B"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStudioItalic"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="I"
                        android:textStyle="italic"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStudioUnderline"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="U"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStudioCaps"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="aA"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Letter Spacing (Kerning) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/dh_letter_spacing"
                        android:textColor="#374151"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStudioLetterSpacingVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="44dp"
                        android:gravity="center"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#EEEEEE"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="0.00"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbStudioLetterSpacing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:max="30"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:progress="0"
                    android:progressTint="?attr/colorPrimary"
                    android:splitTrack="false"
                    android:thumbTint="?attr/colorPrimary" />

                <!-- Line Spacing (Leading) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/dh_line_spacing"
                        android:textColor="#374151"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStudioLineSpacingVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="44dp"
                        android:gravity="center"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#EEEEEE"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="1.0x"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbStudioLineSpacing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:max="20"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:progress="2"
                    android:progressTint="?attr/colorPrimary"
                    android:splitTrack="false"
                    android:thumbTint="?attr/colorPrimary" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 4. Unified Effects View (Stroke, Shadow, Highlight Ribbon) - Scrollable -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/viewStudioEffects"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="always"
            android:scrollbars="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- Section A: Text Stroke / Outline -->
                <LinearLayout
                    android:id="@+id/sectionStudioStroke"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/dh_stroke_width"
                            android:textColor="#374151"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStudioStrokeVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="44dp"
                            android:gravity="center"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#EEEEEE"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="0dp"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sbStudioStroke"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="4dp"
                        android:max="16"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:progress="0"
                        android:progressTint="?attr/colorPrimary"
                        android:splitTrack="false"
                        android:thumbTint="?attr/colorPrimary" />

                    <!-- Stroke Color Category Chips Container -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="4dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/containerStudioStrokeChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvStudioStrokeColors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/dividerStudioStroke"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#F3F4F6" />

                <!-- Section B: Drop Shadow Blur -->
                <LinearLayout
                    android:id="@+id/sectionStudioShadow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/dh_drop_shadow_blur"
                            android:textColor="#374151"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStudioShadowValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="44dp"
                            android:gravity="center"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#EEEEEE"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="0dp"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sbStudioShadow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="4dp"
                        android:max="25"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:progress="0"
                        android:progressTint="?attr/colorPrimary"
                        android:splitTrack="false"
                        android:thumbTint="?attr/colorPrimary" />

                    <!-- Shadow Color Palette -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/dh_shadow_color"
                        android:textColor="#4B5563"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvStudioShadowColors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/dividerStudioShadow"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#F3F4F6" />

                <!-- Section C: Ribbon / Highlight -->
                <LinearLayout
                    android:id="@+id/sectionStudioRibbon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/dh_ribbon_roundness"
                            android:textColor="#374151"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStudioRadiusVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="44dp"
                            android:gravity="center"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#EEEEEE"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="12dp"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sbStudioRadius"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="4dp"
                        android:max="32"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:progress="12"
                        android:progressTint="?attr/colorPrimary"
                        android:splitTrack="false"
                        android:thumbTint="?attr/colorPrimary" />

                    <!-- Ribbon Color Category Chips Container -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="4dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/containerStudioRibbonChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvStudioRibbonColors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

</LinearLayout>