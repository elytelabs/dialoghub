<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/rounded_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <!-- Top Material Drag Handle Pill -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header with Title, Live Preview Swatch, and Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/choose_color"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Live Color Preview Pill with Hex Code -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="#F0F0F0"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="10dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <View
                        android:id="@+id/viewSelectedColorPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFD700" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvHexCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="#FFD700"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?actionBarItemBackground"
            android:contentDescription="Close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Colors Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/colorRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        tools:listitem="@layout/item_color" />

    <!-- Opacity Section Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/transparency"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOpacityValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_background"
            android:backgroundTint="#EEEEEE"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="100%"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Transparency Slider -->
    <SeekBar
        android:id="@+id/transparencySeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="225"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:progress="225"
        android:progressTint="?attr/colorPrimary"
        android:thumbTint="?attr/colorPrimary" />

    <!-- Modern Apply Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyColor"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="Apply Color"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:cornerRadius="12dp" />

</LinearLayout>