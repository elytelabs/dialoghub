<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_gravity="center"
    android:layout_margin="6dp"
    app:cardBackgroundColor="#E0E0E0"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:cardMaxElevation="4dp"
    app:cardPreventCornerOverlap="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/colorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/selectedCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/ivColorLockBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_lock_badge"
            android:contentDescription="@string/dh_locked"
            android:padding="2dp"
            android:src="@drawable/ic_lock_badge"
            android:visibility="gone" />

        <View
            android:id="@+id/selectedOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/selected_border_circle"
            android:visibility="gone" />
    </FrameLayout>

</androidx.cardview.widget.CardView>